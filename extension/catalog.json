{
  "_comment": "Allowlist shared by the extension and the daemon. Anything not listed here is refused by BOTH. Money-out, order entry and account-security endpoints are deliberately absent (see DESIGN.md).",
  "auth_params": ["clientId", "culture", "ip", "port", "otpToken"],
  "endpoints": {
    "portfolio":             {"path": "Wallet/getStockSummaryAsync", "params": ["date"], "extra": {"gateAsp": "0"}, "app_number": true, "doc": "Positions, cost, P/L, cash balances (T/T+1/T+2), credit limit. date=YYYY-MM-DD"},
    "overall_history":       {"path": "Wallet/getCustomerOverallHistoryAsync", "params": ["startDate", "endDate"], "doc": "Portfolio value history (chart data)"},
    "bank_statement":        {"path": "Wallet/getBankStatementAsync", "params": ["startDate", "endDate"], "doc": "Cash account statement (movements). Dates YYYYMMDD"},
    "stock_extract":         {"path": "Wallet/getStockExtractAsync", "params": ["startDate", "endDate"], "doc": "Securities (lot) movements. Dates YYYYMMDD"},
    "executed_transactions": {"path": "Wallet/getExecutedTransactionAsync", "params": ["startDate", "endDate", "symbolId"], "doc": "Executed trades over a date range (no 10-day limit). Dates YYYYMMDD. Omit symbolId for all symbols (an empty string is rejected with 400)"},
    "transaction_result_form": {"path": "Wallet/getTransactionResultFormAsync", "params": ["transactionDate"], "doc": "Daily trade confirmation (işlem sonuç formu). YYYYMMDD"},
    "stoppage":              {"path": "Wallet/getStoppageAsync", "params": [], "doc": "Withholding tax (stopaj) summary"},
    "stoppage_detail":       {"path": "Wallet/getStoppageDetailAsync", "params": ["instrument"], "doc": "Withholding tax detail for one instrument"},
    "order_tracking":        {"path": "StockOrder/getStockOrderTrackingAsync", "params": ["chainOrderActive", "realizedDetail", "retType"], "extra": {"gateAsp": "0"}, "app_number": true, "doc": "Today's equity orders (all channels). Defaults chainOrderActive=1 retType=2"},
    "synthetic_orders":      {"path": "StockOrder/getSyntheticOrderAsync", "params": [], "doc": "Waiting conditional (synthetic) orders"},
    "synthetic_order_logs":  {"path": "StockOrder/GetSyntheticOrderLogsAsync", "params": ["symbolId", "startDate", "finishDate"], "doc": "Conditional order history. Dates DD/MM/YYYY"},
    "order_summary":         {"path": "OrderTransaction/getSummaryInfoAsync", "params": ["transactionDate"], "doc": "Order summary info for a day"},
    "sub_markets":           {"path": "OrderTransaction/getCustomerSubMarketAsync", "params": [], "doc": "Sub-markets the account may trade"},
    "gmo_positions":         {"path": "OrderTransaction/getGmoUserPositionAsync", "params": ["retType"], "doc": "Foreign (GMO) positions"},
    "price_info":            {"path": "StockOrder/getStockPriceInfoAsync", "params": ["symbolId", "symbol", "market", "buyCell", "detail"], "app_number": true, "doc": "Bid/ask, floor/ceiling, limit, sellable balance, cost, gross settlement flag"},
    "current_price":         {"path": "StockOrder/currentPriceAsync", "params": ["symbolId", "stock", "market"], "doc": "Current price"},
    "depth":                 {"path": "StockOrder/getStockDepthsAsync", "params": ["symbolId"], "doc": "Order book snapshot: b0..b4 bid price, v0..v4 bid quantity, q0..q4 bid order count, a0..a4 ask price, w0..w4 ask quantity, k0..k4 ask order count. Often all zeros: MobilG pushes live depth over SignalR; use price_info for the best bid/ask"},
    "last_trades":           {"path": "StockOrder/getLastCompletedAsync", "params": ["symbolId"], "doc": "Recent trades tape: price, quantity, time"},
    "akd":                   {"path": "StockOrder/getAkdDatasAsync", "params": ["stockCode"], "doc": "Broker distribution (AKD). Empty without AKD licence"},
    "metrics":               {"path": "StockOrder/getMetricAsync", "params": ["symbol", "type"], "doc": "Foreign (US) stocks only: 52w high/low, returns, avg volume, valuation. Returns zeros for BIST symbols"},
    "stock_detail":          {"path": "StockOrder/getStockDetailAsync", "params": ["symbol"], "doc": "Company / instrument detail"},
    "stock_list":            {"path": "StockOrder/getAllStockListAsync", "params": ["type", "buySell", "shortSell"], "doc": "All instruments with symbolId (sid), market, prices. type=dashboard shortSell=0"},
    "highlights":            {"path": "StockOrder/getStockHighlightsAsync", "params": [], "doc": "Highlighted symbols"},
    "model_portfolio":       {"path": "StockOrder/getModelPortfolioStocksAsync", "params": [], "doc": "Broker model portfolio"},
    "stock_reports":         {"path": "StockOrder/getStockReportsAsync", "params": ["page", "symbol"], "doc": "Research reports list"},
    "stock_report_detail":   {"path": "StockOrder/getStockReportDetailAsync", "params": ["id"], "doc": "One research report"},
    "foreign_price":         {"path": "StockOrder/getForeignStockPriceInfoAsync", "params": ["stock"], "doc": "Foreign stock price"},
    "depth_steps":           {"path": "Dashboard/getDepthStepsAsync", "params": ["highPrice", "lowPrice", "stepPrice", "selectedPrice"], "doc": "Price ladder steps between two prices"},
    "stock_messages":        {"path": "Dashboard/getStockMessagesAsync", "params": ["market"], "doc": "Market/session notices"},
    "follow_lists":          {"path": "User/getDashboardAsync", "params": [], "doc": "Follow lists (watchlists) and their symbols"},
    "kap_for_symbol":        {"path": "Kap/getStockKapNatificationsAsync", "params": ["symbol"], "doc": "KAP disclosures for a symbol"},
    "kap_notifications":     {"path": "Kap/getUserKapNotificationListAsync", "params": ["readStatus"], "doc": "User's KAP notifications"},
    "news_categories":       {"path": "News/getNewsCategoryAsync", "params": [], "doc": "News categories"},
    "news":                  {"path": "News/getNewsListAsync", "params": ["categoryId", "page"], "doc": "News list"},
    "price_alarms":          {"path": "StockNotification/getStockNotificationListAsync", "params": [], "doc": "Price alarms"},
    "position_notifications":{"path": "UserPositionNotification/getUserPositionNotificationListAsync", "params": [], "doc": "Fill / position notifications"},
    "messages":              {"path": "UserMessages/getUserMessagesAsync", "params": ["readStatus"], "doc": "Broker messages"},
    "ai_profile":            {"path": "OthersService/GetAiProfileAsync", "params": [], "doc": "AI trading authorization profile (read only)"},
    "ai_pending":            {"path": "OthersService/GetAiPendingConfirmationsAsync", "params": ["customer_no"], "doc": "Pending AI order confirmations (read only)"},
    "viop_overall":          {"path": "Viop/getViopOverallAsync", "params": ["transactionDate"], "doc": "VIOP overall"},
    "viop_orders":           {"path": "Viop/viopOrderTrackingAsync", "params": [], "app_number": true, "doc": "VIOP orders"},
    "viop_executed":         {"path": "Viop/getExecutedTransactionAsync", "params": ["startDate", "endDate", "rptId", "sessionId", "contract"], "doc": "VIOP executed"},
    "viop_account_extract":  {"path": "Viop/getAccountExtractAsync", "params": ["startDate", "endDate"], "doc": "VIOP account extract"},
    "viop_cash_movements":   {"path": "Viop/getCashmovementsExtractAsync", "params": ["startDate", "endDate"], "doc": "VIOP cash movements"},
    "viop_pnl":              {"path": "Viop/getProfitLossReportAsync", "params": ["startDate", "endDate"], "doc": "VIOP P/L report"},
    "viop_price":            {"path": "Viop/getViopPriceInfoAsync", "params": ["symbolId"], "doc": "VIOP contract price"},
    "viop_collateral_balance":{"path": "Viop/GetCollateralCustomerBalanceAsync", "params": [], "doc": "VIOP collateral balance"},
    "viop_collateral_report":{"path": "Viop/getViopCollateralReportAsync", "params": ["startDate", "endDate"], "doc": "VIOP collateral report"},
    "t0_report":             {"path": "T0/getT0ReportAsync", "params": ["startDate", "finishDate"], "doc": "T+0 usage report"},
    "t0_price_tables":       {"path": "T0/getT0PriceTablesAsync", "params": [], "doc": "T+0 price tables"},
    "transfer_in":           {"path": "Transfer/getTransferReportInAsync", "params": [], "doc": "Incoming securities transfers (virman)"},
    "transfer_out":          {"path": "Transfer/getTransferReportOutAsync", "params": [], "doc": "Outgoing securities transfers"},
    "credit_info":           {"path": "Transfer/getCustomerCreditInfoAsync", "params": [], "doc": "Credit info"},
    "eft_history":           {"path": "EFT/getEFTTransactionReportListAsync", "params": ["startDate", "FinishDate", "status"], "doc": "EFT history (read only; no transfer endpoints exist here)"},
    "fx_balance":            {"path": "ForeignCurrency/getForeignCurrencyBalanceAsync", "params": ["pageType"], "app_number": true, "doc": "Foreign currency balances"},
    "fx_rates":              {"path": "ForeignCurrency/getForeignCurrencyRatesAsync", "params": [], "doc": "FX rates"},
    "foreign_summary":       {"path": "ForeignShares/getAccountSummaryAsync", "params": [], "doc": "Foreign shares account summary"},
    "foreign_history":       {"path": "ForeignShares/getHistoricalTransactionAsync", "params": ["startDate", "endDate", "sessionId"], "doc": "Foreign shares history"},
    "foreign_derivative":    {"path": "ForeignDerivative/getAsync", "params": ["startDate", "endDate", "rptId"], "doc": "Foreign derivatives"},
    "public_offerings":      {"path": "PublicOffering/getPublicOfferingAsync", "params": ["requestType"], "doc": "Open public offerings (halka arz)"},
    "public_offering_requests": {"path": "PublicOffering/requestListAsync", "params": ["publicOfferingId", "requestType", "allPublicOfferings"], "doc": "Your public offering requests"},
    "fund_types":            {"path": "InvestmentFund/getFunTypeAsync", "params": [], "doc": "Fund types"},
    "fund_founders":         {"path": "InvestmentFund/getFundFounderListAsync", "params": [], "doc": "Fund founders"},
    "fund_list":             {"path": "InvestmentFund/fundReceiptListAsync", "params": ["fundTransactionPlace", "fundType", "fundBuilderCode"], "doc": "Funds"},
    "fund_requests":         {"path": "InvestmentFund/getFundRequestListAsync", "params": [], "doc": "Your fund requests"},
    "fund_sale_list":        {"path": "InvestmentFund/getFundSaleListAsync", "params": [], "doc": "Fund sale list"},
    "server_time":           {"path": "User/GetServerTime", "params": [], "auth": false, "doc": "Server time"},
    "chart_history":         {"path": "chart/history", "params": ["symbol", "resolution", "from", "to", "session", "menkultype", "description"], "auth": false, "doc": "OHLCV candles (TradingView UDF). resolution 1,5,15,60,1D...; from/to unix seconds"}
  },
  "writes": {
    "follow_add":        {"path": "FollowList/addAsync", "method": "POST", "body": ["userDashboardId", "stock", "order", "market"], "doc": "Add a symbol to a follow list"},
    "follow_delete":     {"path": "FollowList/deleteAsync", "method": "DELETE", "params": ["followListId"], "doc": "Remove a symbol from a follow list"},
    "follow_reorder":    {"path": "FollowList/updateOrderAsync", "method": "PUT", "body": ["*"], "doc": "Reorder a follow list"},
    "list_add":          {"path": "Dashboard/addAsync", "method": "POST", "body": ["*"], "doc": "Create a follow list"},
    "list_update":       {"path": "Dashboard/updateAsync", "method": "PUT", "body": ["*"], "doc": "Rename a follow list"},
    "list_delete":       {"path": "Dashboard/deleteAsync", "method": "DELETE", "params": ["userDashboardId"], "doc": "Delete a follow list"},
    "alarm_add":         {"path": "StockNotification/addStockNotificationAsync", "method": "POST", "body": ["*"], "doc": "Add a price alarm"},
    "alarm_delete":      {"path": "StockNotification/deleteStockNotificationAsync", "method": "POST", "body": ["*"], "doc": "Delete a price alarm"}
  },
  "denied_prefixes": ["Auth/", "Setting/", "EFT/money", "EFT/eft", "EFT/Set", "EFT/remove", "Transfer/send", "ForeignCurrency/set", "ForeignCurrency/send", "Viop/ViopCollateral", "Viop/viopBuy", "Viop/viopOrderImprovement", "Viop/viopOrderCancel", "StockOrder/buySell", "StockOrder/BuySell", "StockOrder/synthetic", "StockOrder/GMO", "StockOrder/sendModel", "OrderTransaction/order", "OrderTransaction/chain", "OrderTransaction/customerSubMarketContract", "InvestmentFund/buySell", "InvestmentFund/FundCancel", "PublicOffering/demand", "PublicOffering/requestCancel", "T0/send", "aiAuthorization", "aiConfirmations/set", "TradingView/"]
}
